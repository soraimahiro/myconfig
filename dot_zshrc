# ~/.zshrc
# Bootstrapper for modular zsh configuration managed by chezmoi.

# 1. Source local configurations (not tracked by chezmoi)
# e.g., local proxy, machine-specific PATHs, Homebrew shellenv
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi

# 2. Source modular configurations (managed by chezmoi)
ZSH_CONFIG_DIR="$HOME/.config/zsh"
for file in env.zsh plugins.zsh config.zsh aliases.zsh; do
    if [[ -f "$ZSH_CONFIG_DIR/$file" ]]; then
        source "$ZSH_CONFIG_DIR/$file"
    fi
done
